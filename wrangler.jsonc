/**
 * Zênite GEO — Data Hub 1.9F staging Worker.
 *
 * This Worker is NOT production Pages and MUST NOT be routed to zenitegeo.com.br.
 * Preview: workers.dev + Custom Domain lab.zenitedatahub.com. No production env.
 *
 * Secret (never in this file): wrangler secret put ZDH_SITE_KEY
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zenitegeo-zdh-pilot",
  "account_id": "4528aaf8eb13126fe8f522d9b2e6f22f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "lab.zenitedatahub.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/favicon.ico",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/assets/*",
      "!/images/*",
      "!/*.css",
      "!/*.js",
      "!/*.mjs",
      "!/*.map",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.gif",
      "!/*.svg",
      "!/*.webp",
      "!/*.avif",
      "!/*.ico",
      "!/*.woff",
      "!/*.woff2",
      "!/*.ttf",
      "!/*.eot"
    ]
  },
  "vars": {
    // Staging ingest hostname is NOT *.zenitegeo.com.br (preview/dev cannot reach that suffix).
    "ZDH_INGEST_URL": "https://zdh-staging.mvgestaoweb.com.br/api/events/ingest",
    "ZDH_TRACKING_ENABLED": "true",
    "ZDH_ENVIRONMENT": "preview",
    "ZDH_CONSENT_COOKIE_NAME": "_zdh_consent",
    // Canonical keys until Zaraz CMP purpose IDs exist. Do not treat as real dashboard IDs.
    "ZDH_CONSENT_PURPOSE_ANALYTICS": "analytics",
    "ZDH_CONSENT_PURPOSE_ADVERTISING": "advertising",
    "ZDH_CONSENT_PURPOSE_USER_DATA": "user_data"
  }
}
